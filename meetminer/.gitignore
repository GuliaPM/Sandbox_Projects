# Private, per-developer data. Never commit any of it.
.local/
.env
.env.*
settings.json
usage.csv
meetings.yaml
desktop-error.log
*.lnk
*.mp4
*.m4a
*.wav

# Environments and caches
.venv/
.build-venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Build output (attach dist/* to a GitHub release instead of committing it)
build/
dist/
publish/

# Generated by evals and tools (the results themselves, evals/results/*.json*, are kept on purpose)
evals/last_results.json
evals/_cache/
evals/results/_*
tools/fake_last_request.json
tools/_*
